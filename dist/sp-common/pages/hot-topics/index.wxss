page{background:#f7faff}.hot-page{background:#f7faff;box-sizing:border-box;min-height:100vh;padding:30rpx 28rpx calc(60rpx + env(safe-area-inset-bottom))}.hot-head{padding:8rpx 4rpx 22rpx}.hot-title{color:#111827;display:block;font-size:42rpx;font-weight:900;line-height:54rpx}.hot-desc{color:#64748b;display:block;font-size:25rpx;line-height:36rpx;margin-top:8rpx}.hot-list{background:#fff;border:1rpx solid rgba(226,232,240,.9);border-radius:24rpx;box-shadow:0 12rpx 34rpx rgba(27,86,180,.06);overflow:hidden}.hot-row{align-items:flex-start;border-top:1rpx solid #eef2f7;display:flex;gap:20rpx;padding:26rpx 24rpx}.hot-row:first-child{border-top:0}.hot-rank{color:#94a3b8;flex-shrink:0;font-size:34rpx;font-weight:900;line-height:44rpx;text-align:center;width:50rpx}.hot-rank--1{color:#ef4444}.hot-rank--2{color:#f97316}.hot-rank--3{color:#2563eb}.hot-main{flex:1;min-width:0}.hot-post-title{color:#111827;display:block;font-size:31rpx;font-weight:900;line-height:42rpx}.hot-post-desc{color:#64748b;display:block;font-size:25rpx;line-height:36rpx;margin-top:8rpx}.hot-meta,.hot-tags{display:flex;flex-wrap:wrap;gap:14rpx;margin-top:14rpx}.hot-meta text{color:#64748b;font-size:22rpx;font-weight:800}.hot-tags text{background:#eff6ff;border-radius:999rpx;color:#2563eb;font-size:22rpx;font-weight:800;padding:4rpx 14rpx}.hot-empty{align-items:center;display:flex;justify-content:center;min-height:220rpx}.hot-empty text{color:#64748b;font-size:28rpx;font-weight:800}