page{background:#f8fafc}.privacy-container{box-sizing:border-box;min-height:100vh;padding:20px 18px}.privacy-container h1{color:#1e293b;font-size:22px;font-weight:700;margin-bottom:8px}.privacy-container .updated{color:#94a3b8;font-size:12px;margin-bottom:20px}.privacy-container h2{color:#334155;font-size:16px;font-weight:600;margin:18px 0 8px}.privacy-container p{color:#475569;font-size:14px;line-height:1.7;margin-bottom:10px}.privacy-container ul{margin-bottom:10px;padding-left:18px}.privacy-container li{color:#475569;font-size:14px;line-height:1.7;margin-bottom:4px}