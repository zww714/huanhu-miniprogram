page{background:#f7faff}.search-page{background:radial-gradient(circle at 14% 0,rgba(30,107,255,.08),transparent 260rpx),linear-gradient(180deg,#fff,#f7faff 42%,#f4f7fb);box-sizing:border-box;min-height:100vh;padding:28rpx 28rpx calc(56rpx + env(safe-area-inset-bottom))}.search-header{background:linear-gradient(180deg,#fff,rgba(247,250,255,.94));padding-bottom:20rpx;position:sticky;top:0;z-index:2}.search-result-bar{border-radius:999rpx;box-shadow:none;height:76rpx;min-height:76rpx;padding:0 26rpx}.search-result-bar .search-bar__input{font-size:28rpx;height:76rpx;line-height:76rpx}.search-summary{color:#475569;display:block;font-size:26rpx;font-weight:800;margin-top:18rpx}.hot-search-card,.search-card,.search-empty{background:#fff;border:1rpx solid rgba(226,232,240,.88);border-radius:28rpx;box-shadow:0 12rpx 32rpx rgba(27,86,180,.06)}.hot-search-card{margin-bottom:22rpx;padding:24rpx}.hot-search-title{color:#111827;display:block;font-size:30rpx;font-weight:900}.hot-search-list{display:flex;flex-wrap:wrap;gap:14rpx;margin-top:18rpx}.hot-search-chip{align-items:center;background:#eaf2ff;border-radius:999rpx;display:flex;height:54rpx;padding:0 22rpx}.hot-search-chip text{color:#1e6bff;font-size:24rpx;font-weight:800}.search-list{display:flex;flex-direction:column;gap:20rpx}.search-card{box-sizing:border-box;display:flex;gap:22rpx;min-height:194rpx;padding:22rpx}.search-cover{align-items:center;background:linear-gradient(135deg,#1e6bff,#7c5cff);border-radius:22rpx;display:flex;flex-shrink:0;height:166rpx;justify-content:center;overflow:hidden;width:206rpx}.search-cover text{color:#fff;font-size:28rpx;font-weight:900}.search-cover-img{border-radius:22rpx;height:166rpx;width:206rpx}.search-main{display:flex;flex:1;flex-direction:column;min-width:0}.search-title-row{align-items:flex-start;display:flex;gap:12rpx}.search-title{color:#111827;flex:1;font-size:32rpx;font-weight:900;line-height:42rpx;min-width:0}.search-type{background:#eaf2ff;border-radius:999rpx;color:#1e6bff;