@import "../../sub-vendors.wxss";page{background:#f8fafc}.my-posts-page{background:#f8fafc;box-sizing:border-box;color:#1e293b;min-height:100vh;padding:16px 16px calc(28px + env(safe-area-inset-bottom))}.page-header{align-items:flex-start;display:flex;gap:12px;justify-content:space-between;margin-bottom:14px}.page-title{color:#0f172a;display:block;font-size:22px;font-weight:800}.page-subtitle{color:#64748b;display:block;font-size:13px;margin-top:5px}.header-actions{display:flex;flex-direction:column;flex-shrink:0;gap:8px}.outline-btn{align-items:center;background:#fff;border:1px solid #bfdbfe;border-radius:999px;box-sizing:border-box;display:flex;height:32px;justify-content:center;min-width:76px;padding:0 12px}.outline-btn text{color:#2563eb;font-size:13px;font-weight:700}.outline-btn.active{background:#2563eb;border-color:#2563eb}.outline-btn.active text{color:#fff}.batch-top{align-items:center;background:#eff6ff;border-radius:12px;display:flex;justify-content:space-between;margin-bottom:12px;padding:10px 12px}.batch-top text{color:#2563eb;font-size:13px;font-weight:700}.post-list{display:flex;flex-direction:column;gap:12px}.post-card{align-items:flex-start;background:#fff;border:1px solid #e2e8f0;border-radius:18px;box-shadow:0 10px 28px rgba(15,23,42,.05);display:flex;gap:10px;padding:16px}.check-box{align-items:center;background:#fff;border:1px solid #cbd5e1;border-radius:50%;display:flex;flex-shrink:0;height:22px;justify-content:center;margin-top:2px;width:22px}.check-box.checked{background:#2563eb;border-color:#2563eb}.check-box text{color:#fff;font-size:13px;font-weight:800}.post-main{flex:1;min-width:0}.post-title-row{align-items:flex-start;display:flex;gap:10px;justify-content:space-between}.post-title{color:#0f172a;flex:1;font-size:17px;font-weight:800;line-height:24px}.visibility{background:#ecfdf5;border-radius:999px;color:#059669;flex-shrink:0;font-size:12px;font-weight:700;padding:4px 9px}.visibility.private{background:#f1f5f9;color:#64748b}.post-excerpt{color:#64748b;display:-webkit-box;font-size:14px;-webkit-line-clamp:2;line-height:21px;margin-top:8px;overflow:hidden;-webkit-box-orient:vertical}.tag-row{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px}.tag{background:#eff6ff;border-radius:999px;color:#2563eb;font-size:12px;font-weight:700;padding:5px 10px}.post-footer{align-items:center;display:flex;gap:12px;justify-content:space-between;margin-top:12px}.post-stats{align-items:center;display:flex;flex-wrap:wrap;gap:12px}.post-stats text{color:#94a3b8;font-size:12px}.more-btn{align-items:center;background:#f8fafc;border-radius:999px;display:flex;flex-shrink:0;height:30px;justify-content:center;width:34px}.more-btn text{color:#64748b;font-size:18px;font-weight:800;line-height:18px}.batch-bar{align-items:center;background:hsla(0,0%,100%,.98);border-top:1px solid #e2e8f0;bottom:0;box-sizing:border-box;display:flex;gap:10px;left:0;padding:10px 16px calc(10px + env(safe-area-inset-bottom));position:fixed;right:0;z-index:20}.batch-count{color:#1e293b;flex:1;font-size:13px;font-weight:800}.batch-action,.batch-danger{background:#eff6ff;border-radius:999px;color:#2563eb;font-size:12px;font-weight:800;padding:8px 10px}.batch-danger{background:#fef2f2;color:#ef4444}