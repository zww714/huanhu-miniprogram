@import "../../sub-vendors.wxss";page{background:#f7faff}.skill-page{background:radial-gradient(circle at 14% 0,rgba(37,99,235,.1),transparent 230px),linear-gradient(180deg,#f7faff,#fff 44%,#f7faff);color:#0f172a;height:100vh}.page-shell{box-sizing:border-box;min-height:100vh;padding:88rpx 46rpx calc(40rpx + env(safe-area-inset-bottom))}.top-nav{align-items:center;display:flex;height:82rpx;justify-content:space-between;margin-bottom:28rpx}.back-icon,.nav-spacer{width:72rpx}.back-icon{color:#334155;font-size:72rpx;font-weight:300;line-height:72rpx}.page-title{color:#111827;font-size:42rpx;font-weight:900;line-height:54rpx}.count-line{align-items:center;color:#475569;display:flex;font-size:29rpx;line-height:40rpx;margin-bottom:44rpx}.dot{background:#2563eb;border-radius:50%;box-shadow:0 0 0 12rpx rgba(37,99,235,.1);height:18rpx;margin-right:24rpx;width:18rpx}.count-number{color:#2563eb;font-size:38rpx;font-weight:900;margin:0 8rpx}.skill-section{margin-top:28rpx}.section-title-row{align-items:center;display:flex;justify-content:space-between;margin-bottom:18rpx}.section-title{color:#0f172a;font-size:32rpx;font-weight:900;line-height:42rpx}.section-count{color:#2563eb;font-size:24rpx;font-weight:800;line-height:32rpx}.section-empty{background:#fff;border:1rpx solid rgba(226,232,240,.86);border-radius:28rpx;color:#94a3b8;display:block;font-size:26rpx;line-height:36rpx;padding:34rpx;text-align:center}.skill-list{display:flex;flex-direction:column;gap:22rpx}.skill-card{align-items:center;background:#fff;border:1rpx solid rgba(226,232,240,.86);border-radius:32rpx;box-shadow:0 12rpx 34rpx rgba(27,86,180,.06);box-sizing:border-box;display:flex;gap:34rpx;min-height:210rpx;padding:36rpx}.skill-icon{align-items:center;background:linear-gradient(180deg,#eef5ff,#e6f0ff);border-radius:28rpx;display:flex;flex-shrink:0;height:104rpx;justify-content:center;width:104rpx}.skill-icon text{color:#2563eb;font-size:48rpx;font-weight:900;line-height:1}.skill-main{flex:1;min-width:0}.skill-head{align-items:center;display:flex;gap:24rpx}.skill-name{color:#111827;font-size:38rpx;font-weight:900;line-height:48rpx}.level-pill{background:#2563eb;border-radius:14rpx;color:#fff;font-size:27rpx;font-weight:900;line-height:32rpx;padding:8rpx 18rpx}.skill-intro{color:#475569;display:block;font-size:26rpx;line-height:36rpx;margin-top:22rpx}.tag-row{display:flex;flex-wrap:wrap;gap:16rpx;margin-top:24rpx}.tag{background:#f1f5f9;border-radius:16rpx;color:#475569;font-size:25rpx;line-height:32rpx;padding:8rpx 20rpx}.arrow{color:#a8b2c3;font-size:56rpx;font-weight:300;line-height:1}.want-card{align-items:center;background:#fff;border:1rpx solid rgba(226,232,240,.86);border-radius:26rpx;display:flex;min-height:88rpx;padding:0 30rpx}.want-card text{color:#ea580c;font-size:28rpx;font-weight:800;line-height:38rpx}