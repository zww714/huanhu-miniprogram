@import "../../sub-vendors.wxss";page{background:#f7faff}.ratings-page{background:radial-gradient(circle at 12% 0,rgba(37,99,235,.08),transparent 240rpx),linear-gradient(180deg,#f7faff,#fff 46%,#f7faff);box-sizing:border-box;color:#0f172a;min-height:100vh;padding:28rpx 32rpx calc(72rpx + env(safe-area-inset-bottom))}.dist-card,.review-card,.summary-card{background:#fff;border:1rpx solid rgba(226,232,240,.86);border-radius:30rpx;box-shadow:0 12rpx 32rpx rgba(27,86,180,.06);box-sizing:border-box}.summary-card{align-items:center;display:flex;gap:24rpx;justify-content:space-between;min-height:190rpx;padding:30rpx 28rpx}.summary-title{color:#0f172a;display:block;font-size:38rpx;font-weight:900;line-height:46rpx}.summary-desc{color:#64748b;display:block;font-size:25rpx;line-height:34rpx;margin-top:12rpx}.score-box{align-items:center;background:#f8fbff;border:1rpx solid #e5eeff;border-radius:28rpx;display:flex;flex-direction:column;flex-shrink:0;justify-content:center;min-height:150rpx;width:150rpx}.score-number{color:#2563eb;font-size:48rpx;font-weight:900;line-height:56rpx}.score-stars{color:#2563eb;font-size:18rpx;line-height:24rpx}.score-count{color:#94a3b8;font-size:21rpx;margin-top:4rpx}.dist-card,.review-card{margin-top:24rpx;padding:28rpx}.section-title{color:#0f172a;display:block;font-size:32rpx;font-weight:900;line-height:42rpx;margin-bottom:22rpx}.dist-row{align-items:center;display:flex;gap:18rpx;margin-top:16rpx}.dist-count,.dist-label{color:#64748b;font-size:24rpx;font-weight:800}.dist-label{width:58rpx}.dist-count{text-align:right;width:34rpx}.dist-track{background:#eef4ff;border-radius:999rpx;flex:1;height:14rpx;overflow:hidden}.dist-fill{background:linear-gradient(90deg,#1e6bff,#7db5ff);border-radius:999rpx;height:14rpx}.review-item{border-bottom:1rpx solid #eef2f8;padding:22rpx 0}.review-item:last-child{border-bottom:0}.review-head{display:flex;gap:20rpx;justify-content:space-between}.review-name{color:#0f172a;font-size:28rpx;font-weight:900}.review-score{color:#2563eb;font-size:25rpx;font-weight:900}.review-tags{color:#2563eb;display:block;font-size:23rpx;font-weight:800;margin-top:10rpx}.review-content{color:#475569;display:block;font-size:26rpx;line-height:38rpx;margin-top:10rpx}.review-time{color:#94a3b8;display:block;font-size:22rpx;margin-top:10rpx}.empty-state{padding:54rpx 0;text-align:center}.empty-state text{color:#94a3b8;font-size:26rpx}