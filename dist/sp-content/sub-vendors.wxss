page{background:#f7faff}.relation-page{background:radial-gradient(circle at 14% 0,rgba(37,99,235,.1),transparent 230px),linear-gradient(180deg,#f7faff,#fff 44%,#f7faff);color:#0f172a;height:100vh}.page-shell{box-sizing:border-box;min-height:100vh;padding:88rpx 54rpx calc(40rpx + env(safe-area-inset-bottom))}.top-nav{align-items:center;display:flex;height:82rpx;justify-content:space-between;margin-bottom:50rpx}.back-icon,.nav-spacer{width:72rpx}.back-icon{color:#334155;font-size:72rpx;font-weight:300;line-height:72rpx}.page-title{color:#111827;font-size:42rpx;font-weight:900;line-height:54rpx}.count-line{align-items:center;color:#475569;display:flex;font-size:29rpx;line-height:40rpx;margin-bottom:30rpx}.count-number{color:#2563eb;font-size:34rpx;font-weight:900;margin:0 8rpx}.user-list{display:flex;flex-direction:column;gap:24rpx}.user-card{align-items:center;background:#fff;border:1rpx solid rgba(226,232,240,.86);border-radius:30rpx;box-shadow:0 12rpx 34rpx rgba(27,86,180,.055);box-sizing:border-box;display:flex;gap:32rpx;min-height:168rpx;padding:28rpx 30rpx}.avatar,.avatar-img{border-radius:50%;flex-shrink:0;height:104rpx;width:104rpx}.avatar{align-items:center;display:flex;justify-content:center;overflow:hidden}.avatar text{color:#2563eb;font-size:38rpx;font-weight:900;line-height:1}.user-main{flex:1;min-width:0}.name-row{align-items:center;display:flex;gap:16rpx}.user-name{color:#111827;font-size:36rpx;font-weight:900;line-height:46rpx}.school-pill{background:#eaf2ff;border-radius:14rpx;color:#2563eb;font-size:24rpx;font-weight:800;line-height:30rpx;padding:5rpx 14rpx}.user-meta{color:#475569;display:block;font-size:27rpx;line-height:38rpx;margin-top:10rpx}.user-intro{color:#64748b;display:block;font-size:27rpx;line-height:38rpx;margin-top:12rpx}.empty-text{color:#94a3b8;font-size:28rpx;line-height:40rpx}