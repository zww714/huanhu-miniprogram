page{background-color:#f5f8fc}.notice-page{background:#f5f8fc;color:#1e293b;min-height:100vh}.notice-nav{align-items:center;background:#fff;border-bottom:1px solid #e2e8f0;box-sizing:border-box;display:flex;height:96px;justify-content:space-between;padding:44px 16px 0}.nav-action{color:#334155;font-size:24px;height:44px;line-height:44px;text-align:center;width:44px}.nav-title{flex:1;font-size:16px;font-weight:800;text-align:center}.notice-summary{align-items:center;background:#fff;border:1px solid #e2e8f0;border-radius:16px;box-shadow:0 8px 24px rgba(15,23,42,.05);display:flex;justify-content:space-between;margin:12px 16px 0;padding:16px}.summary-left{align-items:center;display:flex;gap:10px}.summary-icon{align-items:center;border-radius:50%;display:flex;height:42px;justify-content:center;width:42px}.summary-icon text{font-size:20px;font-weight:900}.summary-title{color:#1e293b;display:block;font-size:18px;font-weight:900}.summary-desc{color:#64748b;display:block;font-size:13px;margin-top:4px}.read-all-btn{background:#eff6ff;border-radius:999px;padding:8px 12px}.read-all-btn text{color:#2563eb;font-size:13px;font-weight:800}.filter-tabs{background:#eaf1fb;border-radius:14px;display:grid;gap:4px;grid-template-columns:repeat(3,1fr);margin:12px 16px 0;padding:4px}.filter-tab{align-items:center;border-radius:11px;display:flex;height:34px;justify-content:center}.filter-tab text{color:#64748b;font-size:13px;font-weight:700}.filter-tab.active{background:#fff;box-shadow:0 4px 12px rgba(15,23,42,.08)}.filter-tab.active text{color:#2563eb}.notice-scroll{height:calc(100vh - 222px)}.notice-list{padding:12px 16px 0}.notice-item{background:#fff;border:1px solid #e2e8f0;border-radius:16px;box-shadow:0 8px 22px rgba(15,23,42,.04);margin-bottom:10px;padding:13px 48px 13px 12px;position:relative}.notice-item.unread{background:#eff6ff;border-color:#bfdbfe}.unread-dot{background:#2563eb;border-radius:50%;height:8px;left:9px;position:absolute;top:18px;width:8px}.notice-body{display:flex;gap:11px;padding-left:8px}.notice-avatar{align-items:center;border-radius:50%;display:flex;flex-shrink:0;height:42px;justify-content:center;overflow:hidden;width:42px}.notice-avatar text{font-size:15px;font-weight:900}.avatar-img{border-radius:50%;height:42px;width:42px}.notice-main{flex:1;min-width:0}.notice-title-row{align-items:center;display:flex;gap:8px;justify-content:space-between}.notice-title{color:#1e293b;font-size:15px;font-weight:600}.notice-title.unread{font-weight:900}.notice-time{color:#94a3b8;flex-shrink:0;font-size:11px}.notice-content{color:#64748b;display:block;font-size:13px;line-height:20px;margin-top:5px}.notice-target{background:#f1f5f9;border-radius:999px;color:#2563eb;display:inline-flex;font-size:12px;font-weight:800;margin-top:8px;padding:4px 8px}.notice-more{align-items:center;border-radius:50%;color:#64748b;display:flex;height:38px;justify-content:center;position:absolute;right:7px;top:9px;width:38px}.notice-more text{font-size:15px;font-weight:900}.empty-card{background:#fff;border:1px solid #e2e8f0;border-radius:16px;margin:40px 24px 0;padding:28px 18px;text-align:center}.empty-title{color:#1e293b;display:block;font-size:17px;font-weight:800}.empty-desc{color:#64748b;display:block;font-size:13px;line-height:20px;margin-top:8px}.bottom-space{height:calc(24px + env(safe-area-inset-bottom))}