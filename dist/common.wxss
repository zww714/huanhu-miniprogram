.floating-post-button{align-items:center;background:#2563eb;border-radius:999rpx;box-shadow:0 12rpx 32rpx rgba(37,99,235,.35);color:#fff;display:flex;height:96rpx;justify-content:center;transition:transform .16s ease,opacity .16s ease;width:96rpx}.floating-post-button--pressed{opacity:.9;transform:scale(.94)}.floating-post-button__plus{color:#fff;font-size:58rpx;font-weight:300;line-height:1;transform:translateY(-2rpx)}