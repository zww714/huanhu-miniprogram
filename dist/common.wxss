.floating-post-button{align-items:center;background:#2563eb;border-radius:999rpx;box-shadow:0 12rpx 32rpx rgba(37,99,235,.35);color:#fff;display:flex;height:96rpx;justify-content:center;transition:transform .16s ease,opacity .16s ease;width:96rpx}.floating-post-button--pressed{opacity:.9;transform:scale(.94)}.floating-post-button__plus{color:#fff;font-size:58rpx;font-weight:300;line-height:1;transform:translateY(-2rpx)}.search-bar{align-items:center;background:#fff;border:1rpx solid #e2e8f0;border-radius:999rpx;box-shadow:0 6rpx 18rpx rgba(15,23,42,.06);box-sizing:border-box;display:flex;min-height:72rpx;padding:0 28rpx}.search-bar__icon{color:#94a3b8;font-size:34rpx;line-height:1;margin-right:16rpx}.search-bar__input{color:#0f172a;flex:1;font-size:26rpx;height:72rpx;line-height:72rpx}.search-bar__input::-moz-placeholder{color:#94a3b8}.search-bar__input::placeholder{color:#94a3b8}