page{background:#f7faff}.settings-detail-page{background:radial-gradient(circle at 12% 0,rgba(37,99,235,.08),transparent 260rpx),linear-gradient(180deg,#f7faff,#f4f7fb);box-sizing:border-box;color:#111827;min-height:100vh;padding:28rpx 32rpx calc(72rpx + env(safe-area-inset-bottom))}.detail-hero{display:flex;flex-direction:column;gap:10rpx;padding:8rpx 4rpx 24rpx}.detail-title{color:#111827;font-size:42rpx;font-weight:900;line-height:52rpx}.detail-desc{color:#64748b;font-size:27rpx;line-height:38rpx}.detail-card{background:#fff;border:1rpx solid #e8eef8;border-radius:28rpx;box-shadow:0 12rpx 34rpx rgba(37,99,235,.06);box-sizing:border-box;margin-top:22rpx;padding:24rpx 28rpx 0}.group-title{color:#2563eb;display:block;font-size:25rpx;font-weight:900;line-height:32rpx;margin-bottom:8rpx}.detail-row{align-items:center;border-bottom:1rpx solid #eef2f8;box-sizing:border-box;display:flex;gap:20rpx;min-height:126rpx}.detail-row.last{border-bottom:0}.detail-row-main{display:flex;flex:1;flex-direction:column;gap:8rpx;min-width:0}.detail-row-title{color:#17233d;font-size:30rpx;font-weight:800;line-height:38rpx}.detail-row-desc{color:#8a96aa;font-size:24rpx;line-height:32rpx}.detail-value{color:#2563eb;flex-shrink:0;font-size:25rpx;font-weight:800;line-height:32rpx}.detail-arrow{color:#b8c2d2;flex-shrink:0;font-size:42rpx;font-weight:500;line-height:42rpx}