page{background-color:#f5f8fc}.edit-page{background:#f5f8fc;box-sizing:border-box;min-height:100vh;padding:16px 14px calc(28px + env(safe-area-inset-bottom))}.form-field{background:#fff;border:1px solid #eef2f7;border-radius:16px;box-shadow:0 8px 22px rgba(15,23,42,.04);margin-bottom:14px;padding:14px}.field-label{color:#1e293b;display:block;font-size:14px;font-weight:700}.label-row{align-items:center;display:flex;justify-content:space-between}.count{color:#94a3b8;font-size:12px}.count.danger{color:#ef4444}.bio-input,.input-wrap{background:#f8fafc;border:1px solid #e2e8f0;border-radius:12px;box-sizing:border-box;margin-top:8px;width:100%}.input-wrap{align-items:center;display:flex;min-height:44px;padding:0 12px}.text-input{color:#1e293b;font-size:14px;height:42px;width:100%}.gender-row{display:grid;gap:8px;grid-template-columns:repeat(3,1fr);margin-top:8px}.gender-option{align-items:center;background:#f8fafc;border:1px solid #e2e8f0;border-radius:999px;box-sizing:border-box;display:flex;height:40px;justify-content:center}.gender-option text{color:#334155;font-size:13px;font-weight:700}.gender-option.active{background:#2563eb;border-color:#2563eb;box-shadow:0 8px 18px rgba(37,99,235,.18)}.gender-option.active text{color:#fff}.bio-input{color:#1e293b;font-size:14px;line-height:20px;min-height:132px;padding:12px}.save-btn{background:#2563eb;border-radius:14px;box-shadow:0 10px 22px rgba(37,99,235,.22);color:#fff;font-size:15px;font-weight:800;height:46px;line-height:46px;margin:22px 0 0}.save-btn::after{border:0}