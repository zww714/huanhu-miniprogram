page{background-color:#f8fafc}.manage-page{background:#f8fafc;color:#1e293b;min-height:100vh}.manage-nav{align-items:center;background:#fff;border-bottom:1px solid #e2e8f0;box-sizing:border-box;display:flex;height:96px;justify-content:space-between;padding:44px 16px 0}.nav-action{color:#334155;font-size:24px;height:44px;line-height:44px;text-align:center;width:44px}.nav-title{flex:1;font-size:16px;font-weight:800;text-align:center}.manage-scroll{height:calc(100vh - 96px)}.card,.empty-card{background:#fff;border:1px solid #e2e8f0;border-radius:14px;box-shadow:0 6px 18px rgba(15,23,42,.04);margin:12px 16px 0;padding:16px}.post-title{color:#0f172a;display:block;font-size:18px;font-weight:900;line-height:25px}.status{border-radius:999px;display:inline-block;font-size:12px;font-weight:800;margin-top:10px;padding:4px 10px}.status.public{background:#dcfce7;color:#059669}.status.private{background:#f1f5f9;color:#64748b}.section-title{display:block;font-size:16px;font-weight:800;margin-bottom:12px}.data-grid{display:grid;gap:10px;grid-template-columns:1fr 1fr}.data-item{background:#f8fafc;border-radius:12px;padding:12px}.data-value{color:#2563eb;display:block;font-size:20px;font-weight:900}.data-label{color:#64748b;display:block;font-size:12px;margin-top:3px}.action-btn{align-items:center;background:#eff6ff;border-radius:12px;display:flex;height:44px;justify-content:center;margin-bottom:10px}.action-btn text{color:#2563eb;font-size:15px;font-weight:800}.action-btn.primary{background:#2563eb}.action-btn.primary text{color:#fff}.action-btn.danger{background:#fef2f2}.action-btn.danger text{color:#ef4444}.empty-title{color:#1e293b;display:block;font-size:17px;font-weight:800}.empty-desc{color:#64748b;display:block;font-size:13px;margin-top:8px}