page{background:#f8fafc}.relation-page{background:#f8fafc;box-sizing:border-box;color:#1e293b;min-height:100vh;padding:16px 16px calc(28px + env(safe-area-inset-bottom))}.page-header{align-items:flex-start;display:flex;gap:12px;justify-content:space-between;margin-bottom:14px}.page-title{color:#0f172a;display:block;font-size:22px;font-weight:800}.page-subtitle{color:#64748b;display:block;font-size:13px;margin-top:5px}.primary-pill{align-items:center;background:#2563eb;border-radius:999px;box-shadow:0 8px 20px rgba(37,99,235,.22);display:flex;flex-shrink:0;height:34px;justify-content:center;padding:0 14px}.header-actions{display:flex;flex-direction:column;flex-shrink:0;gap:8px}.primary-pill text{color:#fff;font-size:13px;font-weight:800}.outline-pill{align-items:center;background:#fff;border:1px solid #bfdbfe;border-radius:999px;display:flex;height:32px;justify-content:center;padding:0 14px}.outline-pill text{color:#2563eb;font-size:13px;font-weight:800}.user-list{display:flex;flex-direction:column;gap:12px}.user-card{align-items:flex-start;background:#fff;border:1px solid #e2e8f0;border-radius:18px;box-shadow:0 10px 28px rgba(15,23,42,.05);display:flex;gap:12px;padding:15px}.avatar{align-items:center;background:linear-gradient(135deg,#2563eb,#60a5fa);border-radius:50%;display:flex;flex-shrink:0;height:50px;justify-content:center;width:50px}.avatar text{color:#fff;font-size:20px;font-weight:800}.user-main{flex:1;min-width:0}.name-row{align-items:center;display:flex;gap:7px;min-width:0}.user-name{color:#0f172a;font-size:17px;font-weight:800;max-width:140px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.special-tag{background:#fef3c7;border-radius:999px;color:#d97706;flex-shrink:0;font-size:11px;font-weight:800;padding:3px 7px}.user-meta{color:#64748b;display:block;font-size:13px;line-height:18px;margin-top:4px}.user-intro{color:#475569;display:-webkit-box;font-size:13px;-webkit-line-clamp:2;line-height:19px;margin-top:5px;overflow:hidden;-webkit-box-orient:vertical}.relation-label{background:#eff6ff;border-radius:999px;color:#2563eb;display:inline-flex;font-size:12px;font-weight:700;margin-top:8px;padding:4px 9px}.side-actions{align-items:center;display:flex;flex-shrink:0;gap:7px}.follow-btn{align-items:center;background:#2563eb;border-radius:999px;display:flex;height:30px;justify-content:center;min-width:54px;padding:0 10px}.follow-btn text{color:#fff;font-size:12px;font-weight:800}.follow-btn.muted{background:#f1f5f9}.follow-btn.muted text{color:#64748b}.more-btn{align-items:center;background:#f8fafc;border-radius:999px;display:flex;height:30px;justify-content:center;width:32px}.more-btn text{color:#64748b;font-size:17px;font-weight:800;line-height:17px}