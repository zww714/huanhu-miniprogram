page{background-color:#f8fafc}.edit-page{background:#f8fafc;box-sizing:border-box;min-height:100vh;padding:8rpx 8rpx calc(12rpx + env(safe-area-inset-bottom))}.form-field{margin-bottom:8rpx}.field-label{color:#1e293b;display:block;font-size:7rpx;font-weight:700}.label-row{align-items:center;display:flex;justify-content:space-between}.count{color:#94a3b8;font-size:6rpx}.count.danger{color:#ef4444}.bio-input,.input-wrap{background:#fff;border:.5rpx solid #e2e8f0;border-radius:6rpx;box-sizing:border-box;margin-top:4rpx;width:100%}.input-wrap{align-items:center;display:flex;min-height:22rpx;padding:0 6rpx}.text-input{color:#1e293b;font-size:7rpx;height:21rpx;width:100%}.gender-row{display:grid;gap:4rpx;grid-template-columns:repeat(3,1fr);margin-top:4rpx}.gender-option{align-items:center;background:#fff;border:.5rpx solid #e2e8f0;border-radius:499.5rpx;box-sizing:border-box;display:flex;height:20rpx;justify-content:center}.gender-option text{color:#334155;font-size:6.5rpx;font-weight:700}.gender-option.active{background:#2563eb;border-color:#2563eb;box-shadow:0 4rpx 9rpx rgba(37,99,235,.18)}.gender-option.active text{color:#fff}.bio-input{color:#1e293b;font-size:7rpx;line-height:10rpx;min-height:66rpx;padding:6rpx}.save-btn{background:#2563eb;border-radius:7rpx;color:#fff;font-size:7.5rpx;font-weight:800;height:23rpx;margin-top:12rpx}