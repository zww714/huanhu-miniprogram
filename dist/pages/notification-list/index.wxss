page{background-color:#f8fafc}.notice-page{background:#f8fafc;color:#1e293b;min-height:100vh}.notice-nav{align-items:center;background:#fff;border-bottom:1px solid #e2e8f0;box-sizing:border-box;display:flex;height:96px;justify-content:space-between;padding:44px 16px 0}.nav-action{color:#334155;font-size:24px;height:44px;line-height:44px;text-align:center;width:44px}.nav-title{flex:1;font-size:16px;font-weight:800;text-align:center}.notice-summary{align-items:center;background:#fff;border:1px solid #e2e8f0;border-radius:14px;display:flex;justify-content:space-between;margin:12px 16px 0;padding:16px}.summary-title{color:#1e293b;display:block;font-size:18px;font-weight:900}.summary-desc{color:#64748b;display:block;font-size:13px;margin-top:4px}.read-all-btn{background:#eff6ff;border-radius:999px;padding:8px 12px}.read-all-btn text{color:#2563eb;font-size:13px;font-weight:800}.notice-scroll{height:calc(100vh - 172px)}.notice-list{padding:12px 16px 0}.notice-item{background:#fff;border:1px solid #e2e8f0;border-radius:14px;box-shadow:0 6px 18px rgba(15,23,42,.04);margin-bottom:10px;padding:13px 44px 13px 12px;position:relative}.notice-item.unread{background:#eff6ff;border-color:#bfdbfe}.unread-dot{background:#2563eb;border-radius:50%;height:8px;left:8px;position:absolute;top:16px;width:8px}.notice-body{display:flex;gap:11px;padding-left:8px}.notice-avatar{align-items:center;background:#dbeafe;border-radius:50%;display:flex;flex-shrink:0;height:42px;justify-content:center;overflow:hidden;width:42px}.notice-avatar text{color:#2563eb;font-size:15px;font-weight:800}.avatar-img{border-radius:50%;height:42px;width:42px}.notice-main{flex:1;min-width:0}.notice-title-row{align-items:center;display:flex;gap:8px;justify-content:space-between}.notice-title{color:#1e293b;font-size:15px;font-weight:600}.notice-title.unread{font-weight:900}.notice-time{color:#94a3b8;flex-shrink:0;font-size:11px}.notice-content{color:#64748b;display:block;font-size:13px;line-height:20px;margin-top:5px}.notice-target{color:#2563eb;display:block;font-size:13px;font-weight:700;margin-top:7px}.notice-more{color:#64748b;font-size:16px;font-weight:800;height:28px;line-height:28px;position:absolute;right:10px;text-align:center;top:12px;width:28px}.empty-card{background:#fff;border:1px solid #e2e8f0;border-radius:14px;margin:40px 24px 0;padding:28px 18px;text-align:center}.empty-title{color:#1e293b;display:block;font-size:17px;font-weight:800}.empty-desc{color:#64748b;display:block;font-size:13px;line-height:20px;margin-top:8px}.bottom-space{height:36px}