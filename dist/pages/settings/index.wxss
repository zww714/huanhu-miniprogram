page{background:#f7faff}.settings-page{background:radial-gradient(circle at 16% 0,rgba(37,99,235,.08),transparent 240rpx),linear-gradient(180deg,#f7faff,#f4f7fb);box-sizing:border-box;color:#111827;min-height:100vh;padding:28rpx 32rpx calc(72rpx + env(safe-area-inset-bottom))}.login-card,.settings-card{background:#fff;border:1rpx solid #e8eef8;border-radius:28rpx;box-shadow:0 12rpx 34rpx rgba(37,99,235,.06);overflow:hidden}.settings-row{align-items:center;border-bottom:1rpx solid #eef2f8;box-sizing:border-box;display:flex;gap:22rpx;min-height:132rpx;padding:0 28rpx}.settings-row.last{border-bottom:0}.settings-icon{align-items:center;border-radius:22rpx;display:flex;flex-shrink:0;height:72rpx;justify-content:center;width:72rpx}.settings-icon text{font-size:28rpx;font-weight:900;line-height:34rpx}.settings-icon--blue{background:#eaf2ff}.settings-icon--blue text{color:#2563eb}.settings-icon--green{background:#eafbf3}.settings-icon--green text{color:#16a34a}.settings-icon--purple{background:#f2eeff}.settings-icon--purple text{color:#7c3aed}.settings-icon--orange{background:#fff4e5}.settings-icon--orange text{color:#f97316}.settings-main{display:flex;flex:1;flex-direction:column;gap:8rpx;min-width:0}.settings-title{color:#17233d;font-size:31rpx;font-weight:800;line-height:38rpx}.settings-desc{color:#8a96aa;font-size:24rpx;line-height:32rpx}.settings-arrow{color:#b8c2d2;flex-shrink:0;font-size:42rpx;font-weight:500;line-height:42rpx}.login-card{align-items:center;display:flex;height:96rpx;justify-content:center;margin-top:24rpx}.login-card text{color:#2563eb;font-size:30rpx;font-weight:800;line-height:38rpx}