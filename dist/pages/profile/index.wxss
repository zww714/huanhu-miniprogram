page{background:#f6faff}.profile-scroll{background:radial-gradient(circle at 12% 0,rgba(37,99,235,.1),transparent 220px),linear-gradient(180deg,#f7fbff,#fff 48%,#f6f8fc);height:calc(100vh - 58px)}.profile-page{box-sizing:border-box;color:#0f172a;min-height:100%;padding:32rpx 32rpx calc(180rpx + env(safe-area-inset-bottom))}.menu-card,.profile-card,.stats-card{background:#fff;border:1rpx solid rgba(226,232,240,.82);box-shadow:0 12rpx 36rpx rgba(27,86,180,.06)}.profile-card{border-radius:32rpx;box-sizing:border-box;padding:32rpx}.profile-main-row{align-items:flex-start;display:flex;gap:22rpx}.avatar-wrap{flex-shrink:0;height:96rpx;position:relative;width:96rpx}.avatar-wrap:active,.edit-profile-btn:active,.menu-row:active,.stat-item:active{transform:scale(.98)}.avatar,.avatar-image{border-radius:50%;box-shadow:0 14rpx 32rpx rgba(37,99,235,.18);height:96rpx;width:96rpx}.avatar{align-items:center;display:flex;justify-content:center;overflow:hidden}.avatar-image{background:#e2e8f0;display:block}.avatar text{color:#fff;font-size:36rpx;font-weight:800;line-height:1}.avatar-edit-tip{align-items:center;background:#2563eb;border:4rpx solid #fff;border-radius:50%;bottom:-4rpx;display:flex;height:34rpx;justify-content:center;position:absolute;right:-4rpx;width:34rpx}.avatar-edit-tip text{color:#fff;font-size:18rpx;font-weight:800;line-height:1}.profile-info{flex:1;min-width:0;padding-top:2rpx}.name-row{align-items:center;display:flex;gap:10rpx}.profile-name{color:#0f172a;font-size:38rpx;font-weight:800;line-height:48rpx;max-width:240rpx}.verify-dot{align-items:center;background:#2563eb;border-radius:50%;box-shadow:0 6rpx 14rpx rgba(37,99,235,.22);display:flex;flex-shrink:0;height:30rpx;justify-content:center;width:30rpx}.verify-dot text{color:#fff;font-size:20rpx;font-weight:900;line-height:1}.profile-meta{color:#64748b;display:block;font-size:24rpx;line-height:34rpx;margin-top:8rpx}.profile-bio{color:#475569;display:block;font-size:26rpx;line-height:38rpx;margin-top:14rpx}.rati