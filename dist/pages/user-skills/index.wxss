page{background:#f8fafc}.viewer-page{background:#f8fafc;color:#0f172a;min-height:100vh}.viewer-header{align-items:center;background:linear-gradient(180deg,#eaf2ff,#f8fafc);display:flex;gap:14px;padding:18px 18px 12px}.back{color:#0f172a;font-size:34px;height:34px;line-height:32px;text-align:center;width:34px}.viewer-title{color:#0f172a;display:block;font-size:22px;font-weight:900;line-height:28px}.viewer-subtitle{color:#64748b;display:block;font-size:13px;margin-top:4px}.list-card{background:#fff;border:1px solid #e2e8f0;border-radius:18px;box-shadow:0 10px 28px rgba(15,23,42,.05);margin:0 16px;padding:4px 14px}.skill-item{border-bottom:1px solid #eef2f7;padding:16px 0}.skill-item:last-child{border-bottom:0}.skill-head{align-items:center;display:flex;gap:8px}.skill-title{color:#0f172a;flex:1;font-size:17px;font-weight:900;line-height:24px}.level-pill{background:#eff6ff;border-radius:999px;color:#2563eb;font-size:12px;font-weight:800;padding:3px 9px}.skill-intro{color:#64748b;display:block;font-size:13px;line-height:20px;margin-top:8px}.skill-meta{display:flex;gap:12px;margin-top:8px}.skill-meta text{color:#94a3b8;font-size:12px}.tag-row{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px}.tag{background:#f1f5f9;border-radius:999px;color:#475569;font-size:12px;font-weight:700;padding:4px 10px}.empty-state{align-items:center;display:flex;justify-content:center;min-height:160px}.empty-state text{color:#94a3b8;font-size:14px}.safe-bottom{height:calc(28px + env(safe-area-inset-bottom))}