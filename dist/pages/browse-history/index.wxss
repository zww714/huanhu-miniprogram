.history-page{background-color:#f8fafc;min-height:100vh;padding:24rpx}.history-header{align-items:center;display:flex;justify-content:space-between;margin-bottom:24rpx;padding:0 8rpx}.history-count{color:#64748b;font-size:26rpx}.history-clear{color:#ef4444;font-size:26rpx;font-weight:600}.history-empty{align-items:center;display:flex;flex-direction:column;justify-content:center;padding:160rpx 0}.empty-icon{color:#cbd5e1;font-size:80rpx;margin-bottom:24rpx}.empty-text{color:#94a3b8;font-size:28rpx}.history-item{align-items:center;background-color:#fff;border:1rpx solid #e2e8f0;border-radius:20rpx;display:flex;gap:20rpx;margin-bottom:16rpx;padding:24rpx}.history-icon{align-items:center;border-radius:50%;display:flex;flex-shrink:0;font-size:32rpx;height:72rpx;justify-content:center;width:72rpx}.history-icon--post{background-color:#eff6ff}.history-icon--skill{background-color:#fef3c7}.history-icon--user{background-color:#ecfdf5}.history-content{flex:1;min-width:0}.history-title{color:#1e293b;display:block;font-size:28rpx;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.history-subtitle{color:#64748b;display:block;font-size:24rpx;margin-top:6rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.history-meta{align-items:flex-end;display:flex;flex-direction:column;flex-shrink:0}.history-type{background-color:#f1f5f9;border-radius:8rpx;color:#94a3b8;font-size:22rpx;margin-bottom:8rpx;padding:4rpx 12rpx}.history-time{color:#94a3b8;font-size:22rpx}