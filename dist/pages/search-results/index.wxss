page{background:#f7faff}.search-page{background:linear-gradient(180deg,#fff,#f7faff 42%,#f4f7fb);box-sizing:border-box;min-height:100vh;padding:9rpx 7rpx 20rpx}.search-header{background:linear-gradient(180deg,#fff,rgba(247,250,255,.94));padding-bottom:6rpx;position:sticky;top:0;z-index:2}.search-result-bar{border-radius:499.5rpx;box-shadow:none;height:19rpx;min-height:19rpx}.search-summary{color:#475569;display:block;font-size:6.5rpx;font-weight:700;margin-top:6rpx}.search-list{display:flex;flex-direction:column;gap:6rpx}.hot-search-card{background:#fff;border:.5rpx solid rgba(226,232,240,.88);border-radius:9rpx;box-shadow:0 5rpx 14rpx rgba(27,86,180,.06);margin-bottom:6rpx;padding:7rpx}.hot-search-title{color:#111827;display:block;font-size:8rpx;font-weight:900}.hot-search-list{display:flex;flex-wrap:wrap;gap:4rpx;margin-top:6rpx}.hot-search-chip{align-items:center;background:#eaf2ff;border-radius:499.5rpx;display:flex;height:14rpx;padding:0 6rpx}.hot-search-chip text{color:#1e6bff;font-size:6rpx;font-weight:800}.search-card{background:#fff;border:.5rpx solid rgba(226,232,240,.88);border-radius:9rpx;box-shadow:0 5rpx 14rpx rgba(27,86,180,.06);display:flex;gap:6rpx;padding:7rpx}.search-cover{align-items:center;background:linear-gradient(135deg,#1e6bff,#60a5fa);border-radius:7rpx;display:flex;flex-shrink:0;height:46rpx;justify-content:center;overflow:hidden;width:54rpx}.search-cover text{color:#fff;font-size:8rpx;font-weight:900}.search-cover-img{border-radius:7rpx;height:46rpx;width:54rpx}.search-main{flex:1;min-width:0}.search-title-row{align-items:flex-start;display:flex;gap:4rpx}.search-title{color:#111827;flex:1;font-size:8rpx;font-weight:900;line-height:11rpx;min-width:0}.search-type{background:#eaf2ff;border-radius:499.5rpx;color:#1e6bff;flex-shrink:0;font-size:5.5rpx;font-weight:800;padding:1rpx 4rpx}.search-desc{color:#475569;display:block;font-size:6.5rpx;line-height:10rpx;margin-top:3rpx}.search-author{align-items:center;display:flex;gap:3rpx;margin-top:4rpx}.search-author-name{color:#1e6bff;font-size:6rpx;font-weight:900}.search-actions text,.search-author-meta{color:#64748b;font-size:6rpx;font-weight:700}.search-actions{display:flex;gap:7rpx;margin-top:4rpx}.search-empty{background:#fff;border-radius:9rpx;box-shadow:0 5rpx 14rpx rgba(27,86,180,.06);padding:20rpx 9rpx;text-align:center}.search-empty text{color:#64748b;font-size:7rpx;font-weight:700}