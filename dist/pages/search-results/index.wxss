page{background:#f7faff}.search-page{background:linear-gradient(180deg,#fff,#f7faff 42%,#f4f7fb);box-sizing:border-box;min-height:100vh;padding:9rpx 7rpx 20rpx}.search-header{background:linear-gradient(180deg,#fff,rgba(247,250,255,.94));padding-bottom:6rpx;position:sticky;top:0;z-index:2}.search-result-bar{border-radius:499.5rpx;box-shadow:none;height:19rpx;min-height:19rpx}.search-summary{color:#475569;display:block;font-size:6.5rpx;font-weight:700;margin-top:6rpx}.search-list{display:flex;flex-direction:column;gap:6rpx}.search-card{background:#fff;border:.5rpx solid rgba(226,232,240,.88);border-radius:9rpx;box-shadow:0 5rpx 14rpx rgba(27,86,180,.06);display:flex;gap:6rpx;padding:7rpx}.search-avatar{align-items:center;background:linear-gradient(135deg,#1e6bff,#60a5fa);border-radius:499.5rpx;display:flex;flex-shrink:0;height:26rpx;justify-content:center;overflow:hidden;width:26rpx}.search-avatar text{color:#fff;font-size:9rpx;font-weight:900}.search-avatar-img{border-radius:499.5rpx;height:26rpx;width:26rpx}.search-main{flex:1;min-width:0}.search-title-row{align-items:center;display:flex;gap:4rpx}.search-title{color:#111827;font-size:8rpx;font-weight:900}.search-type{background:#eaf2ff;border-radius:499.5rpx;color:#1e6bff;font-size:5.5rpx;font-weight:800;padding:1rpx 4rpx}.search-desc{color:#475569;display:block;font-size:6.5rpx;line-height:10rpx;margin-top:3rpx}.search-tags{display:flex;flex-wrap:wrap;gap:3rpx;margin-top:4rpx}.search-tags text{background:#f1f5f9;border-radius:4rpx;color:#64748b;font-size:5.5rpx;font-weight:700;padding:1.5rpx 4rpx}.search-empty{background:#fff;border-radius:9rpx;box-shadow:0 5rpx 14rpx rgba(27,86,180,.06);padding:20rpx 9rpx;text-align:center}.search-empty text{color:#64748b;font-size:7rpx;font-weight:700}