page{background-color:#f8fafc}.skill-page{background:#f8fafc;color:#1e293b;min-height:100vh}.skill-nav{align-items:center;background:#fff;border-bottom:1px solid #e2e8f0;box-sizing:border-box;display:flex;height:96px;justify-content:space-between;padding:44px 16px 0}.nav-action{color:#334155;font-size:24px;height:44px;line-height:44px;text-align:center;width:44px}.nav-title{color:#1e293b;flex:1;font-size:16px;font-weight:700;min-width:0;text-align:center}.skill-scroll{height:calc(100vh - 96px)}.hero-card,.info-card{background:#fff;border:1px solid #e2e8f0;border-radius:14px;box-shadow:0 6px 18px rgba(15,23,42,.04);margin:12px 16px 0}.hero-card{display:flex;gap:14px;padding:18px}.skill-icon{align-items:center;background:#eff6ff;border-radius:16px;display:flex;flex-shrink:0;height:58px;justify-content:center;width:58px}.skill-icon text{color:#2563eb;font-size:20px;font-weight:800}.hero-main{flex:1;min-width:0}.hero-title-row,.level-row,.proof-head{align-items:center;display:flex;gap:8px;justify-content:space-between}.skill-name{color:#0f172a;font-size:20px;font-weight:800}.verify-badge{background:#dcfce7;border-radius:999px;color:#059669;flex-shrink:0;font-size:11px;font-weight:700;padding:3px 8px}.verify-badge.muted{background:#f1f5f9;color:#64748b}.skill-level{color:#2563eb;display:block;font-size:14px;font-weight:700;margin-top:4px}.skill-category{background:#f1f5f9;border-radius:6px;color:#475569;display:inline-block;font-size:12px;margin-top:8px;padding:3px 9px}.ability-desc,.empty-desc,.proof-desc,.skill-summary{color:#64748b;display:block;font-size:13px;line-height:20px}.skill-summary{margin-top:10px}.info-card{padding:16px}.section-title{color:#1e293b;display:block;font-size:16px;font-weight:800;margin-bottom:12px}.level-main{color:#2563eb;font-size:24px;font-weight:800}.level-text{color:#475569;font-size:13px;font-weight:700}.progress-track{background:#e2e8f0;border-radius:999px;height:8px;margin:10px 0 12px;overflow:hidden}.progress-fill{background:#2563eb;border-radius:999px;height:100%}.help-list,.proof-list{display:flex;flex-direction:column;gap:10px}.help-item{align-items:center;background:#f8fafc;border-radius:10px;display:flex;gap:10px;padding:10px 12px}.help-dot{background:#dbeafe;border-radius:50%;color:#2563eb;font-size:12px;font-weight:800;height:18px;line-height:18px;text-align:center;width:18px}.help-text{color:#334155;flex:1;font-size:13px}.proof-item{border-bottom:1px solid #f1f5f9;display:flex;gap:12px;padding:12px 0}.proof-item.clickable{cursor:pointer}.proof-item:last-child{border-bottom:none}.proof-icon{align-items:center;background:#eff6ff;border-radius:12px;display:flex;flex-shrink:0;height:42px;justify-content:center;width:42px}.proof-icon text{color:#2563eb;font-size:12px;font-weight:800}.proof-body{flex:1;min-width:0}.proof-title{color:#1e293b;font-size:14px;font-weight:700}.proof-type{background:#f1f5f9;border-radius:999px;color:#64748b;flex-shrink:0;font-size:11px;padding:2px 7px}.proof-desc{margin-top:5px}.proof-link{color:#2563eb;display:block;font-size:12px;margin-top:4px}.proof-more{color:#2563eb;display:block;font-size:12px;font-weight:700;margin-top:6px}.proof-empty{background:#f8fafc;border-radius:10px;padding:16px}.proof-empty text{color:#64748b;font-size:13px;line-height:20px}.tag-wrap{display:flex;flex-wrap:wrap;gap:8px}.skill-tag{background:#eff6ff;border-radius:999px;color:#2563eb;font-size:13px;font-weight:600;padding:6px 12px}.bottom-space{height:calc(78px + env(safe-area-inset-bottom, 0px))}.bottom-bar{background:hsla(0,0%,100%,.96);border-top:1px solid #e2e8f0;bottom:0;left:0;padding:10px 16px calc(12px + env(safe-area-inset-bottom, 0px));position:fixed;right:0}.contact-btn{align-items:center;background:#2563eb;border-radius:12px;display:flex;height:46px;justify-content:center}.contact-btn text{color:#fff;font-size:16px;font-weight:800}.empty-wrap{background:#fff;border:1px solid #e2e8f0;border-radius:14px;margin:80px 24px 0;padding:28px 18px;text-align:center}.empty-title{color:#1e293b;display:block;font-size:17px;font-weight:800;margin-bottom:8px}