page{background-color:#f8fafc}.skill-page{background:#f8fafc;color:#1e293b;min-height:100vh}.skill-nav{align-items:center;background:#fff;border-bottom:.5rpx solid #e2e8f0;box-sizing:border-box;display:flex;height:48rpx;justify-content:space-between;padding:22rpx 8rpx 0}.nav-action{color:#334155;font-size:12rpx;height:22rpx;line-height:22rpx;text-align:center;width:22rpx}.nav-title{color:#1e293b;flex:1;font-size:8rpx;font-weight:700;min-width:0;text-align:center}.skill-scroll{height:calc(100vh - 48rpx)}.hero-card,.info-card{background:#fff;border:.5rpx solid #e2e8f0;border-radius:7rpx;box-shadow:0 3rpx 9rpx rgba(15,23,42,.04);margin:6rpx 8rpx 0}.hero-card{display:flex;gap:7rpx;padding:9rpx}.skill-icon{align-items:center;background:#eff6ff;border-radius:8rpx;display:flex;flex-shrink:0;height:29rpx;justify-content:center;width:29rpx}.skill-icon text{color:#2563eb;font-size:10rpx;font-weight:800}.hero-main{flex:1;min-width:0}.hero-title-row,.level-row,.proof-head{align-items:center;display:flex;gap:4rpx;justify-content:space-between}.skill-name{color:#0f172a;font-size:10rpx;font-weight:800}.verify-badge{background:#dcfce7;border-radius:499.5rpx;color:#059669;flex-shrink:0;font-size:5.5rpx;font-weight:700;padding:1.5rpx 4rpx}.verify-badge.muted{background:#f1f5f9;color:#64748b}.skill-level{color:#2563eb;display:block;font-size:7rpx;font-weight:700;margin-top:2rpx}.skill-category{background:#f1f5f9;border-radius:3rpx;color:#475569;display:inline-block;font-size:6rpx;margin-top:4rpx;padding:1.5rpx 4.5rpx}.ability-desc,.empty-desc,.proof-desc,.skill-summary{color:#64748b;display:block;font-size:6.5rpx;line-height:10rpx}.skill-summary{margin-top:5rpx}.info-card{padding:8rpx}.section-title{color:#1e293b;display:block;font-size:8rpx;font-weight:800;margin-bottom:6rpx}.level-main{color:#2563eb;font-size:12rpx;font-weight:800}.level-text{color:#475569;font-size:6.5rpx;font-weight:700}.progress-track{background:#e2e8f0;border-radius:499.5rpx;height:4rpx;margin:5rpx 0 6rpx;overflow:hidden}.progress-fill{background:#2563eb;border-radius:499.5rpx;height:100%}.help-list,.proof-list{display:flex;flex-direction:column;gap:5rpx}.help-item{align-items:center;background:#f8fafc;border-radius:5rpx;display:flex;gap:5rpx;padding:5rpx 6rpx}.help-dot{background:#dbeafe;border-radius:50%;color:#2563eb;font-size:6rpx;font-weight:800;height:9rpx;line-height:9rpx;text-align:center;width:9rpx}.help-text{color:#334155;flex:1;font-size:6.5rpx}.proof-item{border-bottom:.5rpx solid #f1f5f9;display:flex;gap:6rpx;padding:6rpx 0}.proof-item:last-child{border-bottom:none}.proof-icon{align-items:center;background:#eff6ff;border-radius:6rpx;display:flex;flex-shrink:0;height:21rpx;justify-content:center;width:21rpx}.proof-icon text{color:#2563eb;font-size:6rpx;font-weight:800}.proof-body{flex:1;min-width:0}.proof-title{color:#1e293b;font-size:7rpx;font-weight:700}.proof-type{background:#f1f5f9;border-radius:499.5rpx;color:#64748b;flex-shrink:0;font-size:5.5rpx;padding:1rpx 3.5rpx}.proof-desc{margin-top:2.5rpx}.proof-link{color:#2563eb;display:block;font-size:6rpx;margin-top:2rpx}.proof-empty{background:#f8fafc;border-radius:5rpx;padding:8rpx}.proof-empty text{color:#64748b;font-size:6.5rpx;line-height:10rpx}.tag-wrap{display:flex;flex-wrap:wrap;gap:4rpx}.skill-tag{background:#eff6ff;border-radius:499.5rpx;color:#2563eb;font-size:6.5rpx;font-weight:600;padding:3rpx 6rpx}.bottom-space{height:46rpx}.bottom-bar{background:hsla(0,0%,100%,.96);border-top:.5rpx solid #e2e8f0;bottom:0;left:0;padding:5rpx 8rpx 12rpx;position:fixed;right:0}.contact-btn{align-items:center;background:#2563eb;border-radius:6rpx;display:flex;height:23rpx;justify-content:center}.contact-btn text{color:#fff;font-size:8rpx;font-weight:800}.empty-wrap{background:#fff;border:.5rpx solid #e2e8f0;border-radius:7rpx;margin:40rpx 12rpx 0;padding:14rpx 9rpx;text-align:center}.empty-title{color:#1e293b;display:block;font-size:8.5rpx;font-weight:800;margin-bottom:4rpx}