page{background:#f8fafc}.relation-page{background:#f8fafc;color:#0f172a;min-height:100vh}.relation-header{align-items:center;background:linear-gradient(180deg,#eaf2ff,#f8fafc);display:flex;gap:14px;padding:18px 18px 12px}.back{color:#0f172a;font-size:34px;height:34px;line-height:32px;text-align:center;width:34px}.page-title{color:#0f172a;display:block;font-size:22px;font-weight:900;line-height:28px}.page-subtitle{color:#64748b;display:block;font-size:13px;margin-top:4px}.user-list{padding:0 16px}.user-card{align-items:center;background:#fff;border:1px solid #e2e8f0;border-radius:18px;box-shadow:0 10px 28px rgba(15,23,42,.05);display:flex;gap:12px;margin-bottom:12px;padding:14px}.avatar{align-items:center;background:linear-gradient(145deg,#2563eb,#60a5fa);border-radius:50%;display:flex;flex-shrink:0;height:48px;justify-content:center;width:48px}.avatar text{color:#fff;font-size:20px;font-weight:900}.user-main{flex:1;min-width:0}.name-row{align-items:center;display:flex;gap:7px}.user-name{color:#0f172a;font-size:16px;font-weight:900;line-height:22px}.special-tag{background:#fef3c7;border-radius:999px;color:#d97706;font-size:11px;font-weight:800;padding:2px 7px}.user-intro,.user-meta{color:#64748b;display:block;font-size:12px;line-height:17px;margin-top:4px}.user-intro{color:#94a3b8}.side-actions{align-items:center;display:flex;flex-shrink:0;gap:8px}.follow-btn{align-items:center;background:#2563eb;border-radius:999px;display:flex;height:30px;justify-content:center;min-width:58px;padding:0 12px}.follow-btn.following{background:#eff6ff;border:1px solid #bfdbfe}.follow-btn text{color:#fff;font-size:12px;font-weight:800}.follow-btn.following text{color:#2563eb}.more{color:#64748b;font-size:18px;font-weight:900;height:30px;line-height:24px;text-align:center;width:28px}.empty-state{align-items:center;background:#fff;border:1px solid #e2e8f0;border-radius:18px;display:flex;justify-content:center;margin-top:12px;min-height:180px}.empty-state text{color:#94a3b8;font-size:14px}.safe-bottom{height:calc(28px + env(safe-area-inset-bottom))}