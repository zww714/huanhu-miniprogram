page{background:#f7faff}.messages-page{background:radial-gradient(circle at 15% 0,rgba(37,99,235,.08),transparent 220px),#f7faff;box-sizing:border-box;color:#0f172a;min-height:100vh;padding:28px 24px calc(102px + env(safe-area-inset-bottom))}.messages-top{align-items:center;display:flex;justify-content:center;margin-bottom:26px;min-height:52px}.page-title{color:#0f172a;font-size:24px;font-weight:800;line-height:32px;text-align:center}.quick-entry-row{display:grid;gap:28px;grid-template-columns:repeat(3,1fr);margin-bottom:34px}.quick-entry{align-items:center;display:flex;flex-direction:column;gap:14px}.quick-icon{align-items:center;border-radius:18px;box-shadow:0 12px 28px rgba(15,23,42,.05);display:flex;height:76px;justify-content:center;position:relative;width:76px}.quick-icon text{font-size:36px;font-weight:900;line-height:1}.quick-icon--like{background:linear-gradient(135deg,#fff1f2,#ffe4e6)}.quick-icon--like text{color:#ff4d5e}.quick-icon--follow{background:linear-gradient(135deg,#eff6ff,#dbeafe)}.quick-icon--follow text{color:#2563eb;font-size:42px}.quick-icon--comment{background:linear-gradient(135deg,#ecfdf5,#d1fae5)}.quick-icon--comment text{color:#20c997;font-size:30px;letter-spacing:-3px}.quick-title{color:#0f172a;font-size:16px;font-weight:700;line-height:22px;white-space:nowrap}.message-badge,.row-badge{align-items:center;background:#ff2d38;border-radius:999px;box-shadow:0 4px 12px rgba(255,45,56,.28);box-sizing:border-box;display:flex;height:22px;justify-content:center;min-width:22px;padding:0 6px}.message-badge{position:absolute;right:-9px;top:-9px}.message-badge text,.row-badge text{color:#fff;font-size:11px;font-weight:800;line-height:14px}.message-list-card{background:#fff;border-radius:24px;box-shadow:0 8px 24px rgba(15,23,42,.06);box-sizing:border-box;padding:18px 18px 4px}.message-row{align-items:center;border-bottom:1px solid #e5eaf2;box-sizing:border-box;display:flex;gap:16px;margin-bottom:18px;min-height:78px;padding:0 0 18px;position:relative}.message-row:last-child{border-bottom:0;margin-bottom:0}.chat-avatar,.system-avatar{align-items:center;border-radius:50%;display:flex;flex-shrink:0;height:64px;justify-content:center;overflow:hidden;width:64px}.system-avatar{background:linear-gradient(135deg,#eef5ff,#dbeafe)}.system-avatar text{color:#2563eb;font-size:24px;font-weight:900}.chat-avatar{background:linear-gradient(135deg,#2563eb,#7db5ff)}.chat-avatar text{color:#fff;font-size:24px;font-weight:900}.chat-avatar-img{border-radius:50%;height:64px;width:64px}.message-main{flex:1;min-width:0}.message-title{color:#0f172a;display:block;font-size:17px;font-weight:700;line-height:24px}.message-content{color:#64748b;display:block;font-size:14px;line-height:20px;margin-top:8px}.message-side{align-items:flex-end;align-self:stretch;display:flex;flex-direction:column;flex-shrink:0;gap:16px;justify-content:flex-start;min-width:42px;padding-top:4px}.message-time{color:#64748b;font-size:13px;line-height:18px}.row-badge{height:22px;min-width:22px}.total-unread-shadow{display:none}