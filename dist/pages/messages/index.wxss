page{background:#f6faff}.messages-page{background:radial-gradient(circle at 15% 0,rgba(37,99,235,.1),transparent 220px),linear-gradient(180deg,#f6faff,#fff 48%,#f8faff);box-sizing:border-box;color:#0f172a;min-height:100vh;padding:36rpx 28rpx calc(170rpx + env(safe-area-inset-bottom))}.message-overview{align-items:center;background:hsla(0,0%,100%,.82);border:1rpx solid #e8eef8;border-radius:28rpx;box-shadow:0 12rpx 34rpx rgba(37,99,235,.08);box-sizing:border-box;display:flex;gap:24rpx;justify-content:space-between;margin:0 0 28rpx;min-height:104rpx;padding:22rpx 26rpx}.message-overview-text{display:flex;flex:1;flex-direction:column;gap:8rpx;min-width:0}.message-overview-title{color:#0f172a;font-size:32rpx;font-weight:900;line-height:40rpx}.message-overview-desc{color:#7a8aa0;font-size:24rpx;line-height:32rpx}.mark-read-btn{align-items:center;background:#2563eb;border-radius:999rpx;box-shadow:0 10rpx 22rpx rgba(37,99,235,.2);display:flex;flex-shrink:0;height:56rpx;justify-content:center;min-width:132rpx}.mark-read-btn text{color:#fff;font-size:24rpx;font-weight:800;line-height:30rpx}.mark-read-btn--disabled{background:#eef2f7;box-shadow:none}.mark-read-btn--disabled text{color:#94a3b8}.quick-entry-row{align-items:flex-start;display:flex;justify-content:space-between;margin:0 0 30rpx}.quick-entry{align-items:center;display:flex;flex-direction:column;gap:14rpx;width:25%}.quick-icon{align-items:center;border-radius:26rpx;box-shadow:0 12px 28px rgba(15,23,42,.05);display:flex;height:88rpx;justify-content:center;position:relative;width:88rpx}.quick-icon > text{font-size:50rpx;font-weight:900;line-height:1}.quick-icon--like{background:linear-gradient(135deg,#fff1f2,#ffe4e6)}.quick-icon--like > text{color:#ff4d5e}.quick-icon--follow{background:linear-gradient(135deg,#eff6ff,#dbeafe)}.quick-icon--follow > text{color:#2563eb;font-size:56rpx}.quick-icon--comment{background:linear-gradient(135deg,#ecfdf5,#d1fae5)}.quick-icon--comment > text{color:#20c997;font-size:42rpx;letter-s