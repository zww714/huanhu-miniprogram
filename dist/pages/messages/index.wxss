page{background:#f6faff}.messages-page{background:radial-gradient(circle at 15% 0,rgba(37,99,235,.1),transparent 220px),linear-gradient(180deg,#f6faff,#fff 48%,#f8faff);box-sizing:border-box;color:#0f172a;min-height:100vh;padding:32rpx 32rpx calc(180rpx + env(safe-area-inset-bottom))}.quick-entry-row{align-items:flex-start;display:flex;justify-content:space-between;margin:0 24rpx 48rpx}.quick-entry{align-items:center;display:flex;flex-direction:column;gap:16px}.quick-icon{align-items:center;border-radius:28rpx;box-shadow:0 12px 28px rgba(15,23,42,.05);display:flex;height:96rpx;justify-content:center;position:relative;width:96rpx}.quick-icon text{font-size:50rpx;font-weight:900;line-height:1}.quick-icon--like{background:linear-gradient(135deg,#fff1f2,#ffe4e6)}.quick-icon--like text{color:#ff4d5e}.quick-icon--follow{background:linear-gradient(135deg,#eff6ff,#dbeafe)}.quick-icon--follow text{color:#2563eb;font-size:56rpx}.quick-icon--comment{background:linear-gradient(135deg,#ecfdf5,#d1fae5)}.quick-icon--comment text{color:#20c997;font-size:42rpx;letter-spacing:-3px}.quick-icon--system{background:linear-gradient(135deg,#f5f3ff,#ede9fe)}.quick-icon--system text{color:#7c3aed;font-size:0}.quick-icon--system text::before{content:"🔔";font-size:38rpx;line-height:1}.quick-title{color:#0f172a;font-size:24rpx;font-weight:700;line-height:36rpx;white-space:nowrap}.message-badge,.row-badge{align-items:center;background:#ff2d38;border-radius:999px;box-shadow:0 4px 12px rgba(255,45,56,.28);box-sizing:border-box;display:flex;height:36rpx;justify-content:center;min-width:36rpx;padding:0 10rpx}.message-badge{position:absolute;right:-8rpx;top:-8rpx}.message-badge text,.row-badge text{color:#fff;font-size:22rpx;font-weight:800;line-height:28rpx}.message-list-card{background:#fff;border-radius:32rpx;box-shadow:0 12rpx 36rpx rgba(27,86,180,.06);box-sizing:border-box;margin:0;padding:28rpx 32rpx 8rpx}.message-row{align-items:center;border-bottom:1rpx solid #edf2fa;box-sizing:border-box;display:flex;gap:28rpx;margin-bottom:24rpx;min-height:132rpx;padding:0 0 24rpx;position:relative}.message-row:last-child{border-bottom:0;margin-bottom:0}.chat-avatar,.system-avatar{align-items:center;border-radius:50%;display:flex;flex-shrink:0;height:88rpx;justify-content:center;overflow:hidden;width:88rpx}.system-avatar{background:linear-gradient(135deg,#eef5ff,#dbeafe)}.system-avatar text{color:#2563eb;font-size:0;font-weight:900}.system-avatar text::before{content:"🔔";font-size:42rpx;line-height:1}.chat-avatar{background:linear-gradient(135deg,#2563eb,#7db5ff)}.chat-avatar text{color:#fff;font-size:30rpx;font-weight:900}.chat-avatar-img{border-radius:50%;height:88rpx;width:88rpx}.message-main{flex:1;min-width:0}.message-title{color:#0f172a;display:block;font-size:30rpx;font-weight:700;line-height:40rpx}.message-content{color:#7a8aa0;display:block;font-size:26rpx;line-height:36rpx;margin-top:10rpx}.message-side{align-items:flex-end;align-self:stretch;display:flex;flex-direction:column;flex-shrink:0;gap:22rpx;justify-content:flex-start;min-width:54rpx;padding-top:6rpx}.message-time{color:#8a96aa;font-size:24rpx;line-height:32rpx}.row-badge{height:36rpx;min-width:36rpx}.total-unread-shadow{display:none}