page{background-color:#f8fafc}.fav-loading{align-items:center;color:#94a3b8;display:flex;font-size:14px;justify-content:center;min-height:60vh}.fav-empty{align-items:center;display:flex;flex-direction:column;justify-content:center;min-height:60vh;padding:0 24px}.fav-empty-text{color:#94a3b8;font-size:15px;font-weight:600}.fav-empty-desc{color:#cbd5e1;font-size:13px;margin-top:6px}.fav-page{min-height:100vh;padding:12px}.fav-card{background:#fff;border:1px solid #e2e8f0;border-radius:12px;margin-bottom:10px;padding:14px}.fav-author-row{align-items:center;display:flex;margin-bottom:8px}.fav-avatar{align-items:center;background:#e2e8f0;border-radius:50%;display:flex;flex-shrink:0;height:28px;justify-content:center;overflow:hidden;width:28px}.fav-avatar-img{height:100%;width:100%}.fav-avatar-text{color:#64748b;font-size:12px;font-weight:700}.fav-author-info{flex:1;margin-left:8px}.fav-author-name{color:#1e293b;font-size:13px;font-weight:600}.fav-author-meta{color:#94a3b8;font-size:11px}.fav-time{color:#94a3b8;font-size:11px}.fav-title{color:#1e293b;display:block;font-size:15px;font-weight:700;margin-bottom:4px}.fav-excerpt{color:#64748b;display:block;font-size:13px;line-height:20px;margin-bottom:8px}.fav-tags{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:8px}.fav-tag{background:#eff6ff;border-radius:20px;color:#3b82f6;display:inline-block;font-size:11px;font-weight:500;padding:2px 10px}.fav-stats{color:#94a3b8;display:flex;font-size:12px;gap:16px}