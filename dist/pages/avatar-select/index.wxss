page{background-color:#f8fafc}.avatar-page{background:#f8fafc;color:#1e293b;min-height:100vh}.avatar-nav{align-items:center;background:#fff;border-bottom:1px solid #e2e8f0;box-sizing:border-box;display:flex;height:96px;justify-content:space-between;padding:44px 16px 0}.nav-action{color:#334155;font-size:24px;height:44px;line-height:44px;text-align:center;width:44px}.nav-title{color:#1e293b;flex:1;font-size:16px;font-weight:800;min-width:0;text-align:center}.avatar-scroll{height:calc(100vh - 96px)}.avatar-grid-card,.intro-card{background:#fff;border:1px solid #e2e8f0;border-radius:14px;box-shadow:0 6px 18px rgba(15,23,42,.04);box-sizing:border-box;margin:12px 16px 0}.intro-card{padding:16px}.intro-title{color:#1e293b;display:block;font-size:17px;font-weight:800}.intro-desc{color:#64748b;display:block;font-size:13px;line-height:20px;margin-top:6px}.avatar-grid-card{padding:16px}.avatar-grid{display:grid;gap:12px;grid-template-columns:repeat(4,1fr)}.avatar-option{align-items:center;background:#f8fafc;border:2px solid transparent;border-radius:14px;box-sizing:border-box;display:flex;flex-direction:column;min-width:0;padding:10px 4px}.avatar-option.selected{background:#eff6ff;border-color:#2563eb;box-shadow:0 8px 18px rgba(37,99,235,.12)}.avatar-option:active{transform:scale(.98)}.avatar-preview{align-items:center;border-radius:50%;display:flex;height:54px;justify-content:center;overflow:hidden;width:54px}.avatar-preview text{font-size:24px;font-weight:900}.avatar-name{color:#475569;display:block;font-size:11px;line-height:15px;margin-top:8px;text-align:center;width:100%}.selected-mark{color:#2563eb;display:block;font-size:11px;font-weight:800;margin-top:4px}.bottom-space{height:40px}