page{background:#f8fafc}.viewer-page{background:#f8fafc;color:#0f172a;min-height:100vh}.viewer-header{align-items:center;background:linear-gradient(180deg,#eaf2ff,#f8fafc);display:flex;gap:14px;padding:18px 18px 12px}.back{color:#0f172a;font-size:34px;height:34px;line-height:32px;text-align:center;width:34px}.viewer-title{color:#0f172a;display:block;font-size:22px;font-weight:900;line-height:28px}.viewer-subtitle{color:#64748b;display:block;font-size:13px;margin-top:4px}.post-list{padding:0 16px}.post-card{background:#fff;border:1px solid #e2e8f0;border-radius:18px;box-shadow:0 10px 28px rgba(15,23,42,.05);margin-bottom:12px;padding:16px}.post-head{align-items:flex-start;display:flex;gap:10px}.post-title{color:#0f172a;flex:1;font-size:17px;font-weight:900;line-height:24px}.post-time{color:#94a3b8;flex-shrink:0;font-size:12px}.post-summary{color:#64748b;display:-webkit-box;font-size:13px;-webkit-line-clamp:2;line-height:20px;margin-top:8px;overflow:hidden;-webkit-box-orient:vertical}.tag-row{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px}.tag{background:#eff6ff;border-radius:999px;color:#2563eb;font-size:12px;font-weight:700;padding:4px 10px}.post-meta{display:flex;gap:14px;margin-top:10px}.post-meta text{color:#94a3b8;font-size:12px}.empty-state{align-items:center;background:#fff;border:1px solid #e2e8f0;border-radius:18px;display:flex;justify-content:center;margin-top:12px;min-height:180px}.empty-state text{color:#94a3b8;font-size:14px}.safe-bottom{height:calc(28px + env(safe-area-inset-bottom))}