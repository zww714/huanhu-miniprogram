page{background:#f7faff}.posts-page{background:radial-gradient(circle at 14% 0,rgba(37,99,235,.1),transparent 230px),linear-gradient(180deg,#f7faff,#fff 42%,#f7faff);color:#0f172a;height:100vh}.page-shell{box-sizing:border-box;min-height:100vh;padding:88rpx 46rpx calc(40rpx + env(safe-area-inset-bottom))}.top-nav{align-items:center;display:flex;height:82rpx;justify-content:space-between;margin-bottom:36rpx}.back-icon,.nav-spacer{width:72rpx}.back-icon{color:#334155;font-size:72rpx;font-weight:300;line-height:72rpx}.page-title{color:#111827;font-size:42rpx;font-weight:900;line-height:54rpx}.private-line{align-items:center;color:#94a3b8;display:flex;font-size:27rpx;gap:14rpx;justify-content:center;line-height:38rpx;margin-bottom:44rpx}.post-list{display:flex;flex-direction:column;gap:28rpx}.post-card{background:#fff;border:1rpx solid rgba(226,232,240,.86);border-radius:30rpx;box-shadow:0 12rpx 34rpx rgba(27,86,180,.06);box-sizing:border-box;padding:24rpx}.post-top{display:flex;gap:28rpx}.post-cover{align-items:center;background:radial-gradient(circle at 22% 18%,hsla(0,0%,100%,.42),transparent 52rpx),linear-gradient(135deg,#c084fc,#2563eb 58%,#0f172a);border-radius:20rpx;display:flex;flex-shrink:0;height:168rpx;justify-content:center;overflow:hidden;width:246rpx}.post-cover text{color:#fff;font-size:58rpx;font-weight:900;line-height:1;opacity:.9}.post-main{flex:1;min-width:0}.post-title{color:#111827;font-size:34rpx;font-weight:900;line-height:46rpx}.post-summary{color:#475569;display:block;font-size:27rpx;line-height:42rpx;margin-top:18rpx}.tag-row{display:flex;flex-wrap:wrap;gap:16rpx;margin-top:18rpx}.tag{background:#eaf2ff;border-radius:999rpx;color:#2563eb;font-size:25rpx;font-weight:700;line-height:32rpx;padding:7rpx 18rpx}.post-divider{background:#e8eef8;height:1rpx;margin:22rpx 0 18rpx}.post-meta{align-items:center;display:grid;gap:16rpx;grid-template-columns:1fr 1fr 1fr auto}.post-meta text{color:#64748b;font-size:26rpx;line-height:34rpx}